NODE_ENV=production
PORT=3001
APP_URL=https://socially.example.com
DATA_DIR=/data

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://socially.example.com/auth/linkedin/callback
LINKEDIN_API_VERSION=202611

# Optional OpenAI-compatible chat-completions provider.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# Optional SMTP for server-side post and networking reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

TRUST_PROXY=true
